def numpy_quantize_weight(w):

    q = np.round(
        w * 128
    )

    q = np.clip(
        q,
        -128,
        127
    )

    return q.astype(
        np.int8
    )


def numpy_quantize_bias(b):

    q = np.round(
        b * 128
    )

    q = np.clip(
        q,
        -128,
        127
    )

    return q.astype(
        np.int8
    )


