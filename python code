#
# We fine-tune the pretrained network.
#
# Small learning rate is important.
# ============================================================

QAT_EPOCHS = 8

qat_optimizer = optim.Adam(
    qat_model.parameters(),
    lr=0.0001,
    weight_decay=1e-5
)


print()
print("==============================================")
print("QUANTIZATION-AWARE TRAINING")
print("==============================================")


best_accuracy = 0.0

best_state = None


for epoch in range(QAT_EPOCHS):


    qat_model.train()

    running_loss = 0.0


    for data, target in train_loader:

        data = data.to(
            device,
            non_blocking=True
        )

        target = target.to(
            device,
            non_blocking=True
        )


        qat_optimizer.zero_grad()


        output = qat_model(
            data
        )


        loss = criterion(
            output,
            target
        )


        loss.backward()


        # ----------------------------------------------------
        # Gradient clipping
        #
        # Prevents QAT weights from exploding.
        # ----------------------------------------------------

        torch.nn.utils.clip_grad_norm_(
            qat_model.parameters(),
            max_norm=1.0
        )


        qat_optimizer.step()


        # ----------------------------------------------------
        # IMPORTANT:
        #
        # Keep master weights inside the hardware
        # representable Q1.7 range.
        #
        # This prevents the previous problem where weights
        # exploded to +/-5.
        # ----------------------------------------------------

        with torch.no_grad():

            for layer in [
                qat_model.layer1,
                qat_model.layer2,
                qat_model.layer3,
                qat_model.layer4
            ]:

                layer.weight.clamp_(
                    QMIN / SCALE,
                    QMAX / SCALE
                )

                layer.bias.clamp_(
                    QMIN / SCALE,
                    QMAX / SCALE
                )


        running_loss += loss.item()


    # --------------------------------------------------------
    # Test after every epoch
    # --------------------------------------------------------

    test_accuracy = evaluate_qat(
        qat_model
    )


    print(
        f"Epoch [{epoch+1}/{QAT_EPOCHS}] "
        f"Loss = "
        f"{running_loss / len(train_loader):.4f} "
        f"| INT8 Accuracy = "
        f"{test_accuracy:.2f}%"
    )


    # --------------------------------------------------------
    # Save best model
    # --------------------------------------------------------

    if test_accuracy > best_accuracy:

        best_accuracy = test_accuracy

        best_state = {
            k: v.detach().cpu().clone()
            for k, v in qat_model.state_dict().items()
        }


