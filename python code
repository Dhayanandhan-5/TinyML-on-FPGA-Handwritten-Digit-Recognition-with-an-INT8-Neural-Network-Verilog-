# 30. EXPORT INT8 BINARY FILE
#
# Each line:
#
#       8-bit two's complement binary
#
# Example:
#
#       +5  -> 00000101
#       -5  -> 11111011
#
# Ready for:
#
#       $readmemb(...)
#
# ============================================================

def write_binary_file(
    filename,
    array
):

    flat = array.flatten()


    with open(
        filename,
        "w"
    ) as f:


        for value in flat:

            unsigned_value = (
                int(value) & 0xFF
            )


            binary = format(
                unsigned_value,
                "08b"
            )


            f.write(
                binary + "\n"
            )


