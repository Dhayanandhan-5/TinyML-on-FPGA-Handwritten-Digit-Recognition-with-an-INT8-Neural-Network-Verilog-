)

print("Using device:", device)


# ============================================================
# 2. RANDOM SEED
# ============================================================

SEED = 42

torch.manual_seed(SEED)
np.random.seed(SEED)

if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)


# ============================================================
# 3. MNIST DATASET
#
# IMPORTANT:
#
# ONLY ToTensor()
#
# NO Normalize()
#
# Hardware receives pixels in [0,1]
# and performs:
#
# floor(pixel * 128)
# ============================================================

transform = transforms.ToTensor()


train_dataset = datasets.MNIST(
    root="./data",
    train=True,
    download=True,
    transform=transform
)


test_dataset = datasets.MNIST(
    root="./data",
    train=False,
    download=True,
    transform=transform
)


train_loader = DataLoader(
    train_dataset,
    batch_size=128,
    shuffle=True,
    num_workers=2,
    pin_memory=True
)


test_loader = DataLoader(
    test_dataset,
    batch_size=256,
    shuffle=False,
    num_workers=2,
    pin_memory=True
)


print()
print("Training samples:", len(train_dataset))
print("Testing samples :", len(test_dataset))


# ============================================================
# 4. MODEL
#
# 784 -> 64 -> 32 -> 16 -> 10
# ============================================================

class DenseMNIST(nn.Module):

    def __init__(self):

        super(DenseMNIST, self).__init__()

        self.layer1 = nn.Linear(784, 64)
        self.layer2 = nn.Linear(64, 32)
        self.layer3 = nn.Linear(32, 16)
        self.layer4 = nn.Linear(16, 10)

    def forward(self, x):

        x = x.view(-1, 784)

        x = torch.relu(
            self.layer1(x)
        )

        x = torch.relu(
            self.layer2(x)
        )

        x = torch.relu(
            self.layer3(x)
        )

        x = self.layer4(x)

        return x


# ============================================================
# 5. FLOATING POINT PRE-TRAINING
#
# We first train a normal model.
#
# Then QAT fine-tunes this trained model.
#
# This is much more stable than starting QAT
# from random weights.
# ============================================================

model = DenseMNIST().to(device)


criterion = nn.CrossEntropyLoss()


optimizer = optim.Adam(
    model.parameters(),
    lr=0.003
)


FLOAT_EPOCHS = 3


print()
print("==============================================")
print("FLOATING-POINT PRE-TRAINING")
print("==============================================")


for epoch in range(FLOAT_EPOCHS):

    model.train()

    running_loss = 0.0

    for data, target in train_loader:

        data = data.to(
            device,
            non_blocking=True
        )

        target = target.to(
            device,
            non_blocking=True
        )


        optimizer.zero_grad()


        output = model(data)


        loss = criterion(
            output,
            target
        )


        loss.backward()


        optimizer.step()


        running_loss += loss.item()


    print(
        f"Epoch {epoch+1}/{FLOAT_EPOCHS} "
        f"Loss = "
        f"{running_loss / len(train_loader):.4f}"
    )


print("Floating-point pre-training complete.")


# ============================================================
# 6. FLOATING POINT TEST ACCURACY
# ============================================================

def evaluate_float(model):

    model.eval()

    correct = 0
    total = 0

    with torch.no_grad():

        for data, target in test_loader:

            data = data.to(device)
            target = target.to(device)

            output = model(data)

            prediction = torch.argmax(
                output,
                dim=1
            )

            correct += (
                prediction == target
            ).sum().item()

            total += target.size(0)


    return 100.0 * correct / total


float_accuracy = evaluate_float(model)


print()
print(
    f"Floating-Point Test Accuracy : "
    f"{float_accuracy:.2f}%"
)


# ============================================================
# 7. HARDWARE QUANTIZATION CONSTANTS
# ============================================================

SCALE = 128.0

QMIN = -128
QMAX = 127


# ============================================================
# 8. STE ROUND
#
# Forward:
#       round(x)
#
# Backward:
#       gradient passes approximately as identity
#
# This is the Straight-Through Estimator.
# ============================================================

def ste_round(x):

    rounded = torch.round(x)

    return (
        rounded.detach()
        + x
        - x.detach()
    )


# ============================================================
# 9. STE FLOOR
#
# Hardware input uses:
#
#       floor(pixel * 128)
#
# We use floor in forward pass but preserve gradient.
# ============================================================

def ste_floor(x):

    floored = torch.floor(x)

    return (
        floored.detach()
        + x
        - x.detach()
    )


# ============================================================
# 10. INT8 WEIGHT QUANTIZATION
#
# Hardware:
#
#       q = round(weight * 128)
#
#       clip [-128,127]
#
#       dequant = q / 128
#
# STE allows gradients to reach the floating point
# master weights.
# ============================================================

def fake_quant_weight(w):

    q = ste_round(
        w * SCALE
    )

    q = torch.clamp(
        q,
        QMIN,
        QMAX
    )

    q = q / SCALE

    return q


# ============================================================
# 11. HARDWARE INPUT QUANTIZATION
#
# Hardware:
#
#       floor(pixel * 128)
#
#       clip to INT8
#
#       dequantize only for PyTorch computation
#
# The actual forward value corresponds to INT8.
# ============================================================

def fake_quant_input(x):

    q = ste_floor(
        x * SCALE
    )

    q = torch.clamp(
        q,
        QMIN,
        QMAX
    )

    q = q / SCALE

    return q


# ============================================================
# 12. HARDWARE-MATCHED QAT LINEAR
#
# IMPORTANT:
#
# This reproduces:
#
#   Wq = round(W*128)
#   Xq = quantized INT8 activation
#
#   ACC = Wq @ Xq
#
#   ACC = ACC + Bq
#
#   ACC = ACC + 64
#
#   ACC = ACC >>> 7
#
#   saturation
#
#   ReLU
#
# We keep the tensors as float for PyTorch autograd,
# but their forward values correspond to the integer
# hardware arithmetic.
# ============================================================

def qat_hardware_linear(
    x,
    weight,
    bias,
    relu=True
):

    # --------------------------------------------------------
    # Quantize weight
    # --------------------------------------------------------

    wq = fake_quant_weight(
        weight
    )

    # --------------------------------------------------------
    # Convert to hardware integer domain
    #
    # x is already represented as Q1.7
    # --------------------------------------------------------

    x_int = x * SCALE
    w_int = wq * SCALE

    # --------------------------------------------------------
    # INT32-equivalent MAC
    #
    # PyTorch uses float storage here,
    # but values are integer-valued.
    # --------------------------------------------------------

    acc = torch.matmul(
        x_int,
        w_int.t()
    )

    # --------------------------------------------------------
    # Quantized bias
    #
    # Hardware stores bias as INT8.
    # --------------------------------------------------------

    b_int = ste_round(
        bias * SCALE
    )

    b_int = torch.clamp(
        b_int,
        QMIN,
        QMAX
    )

    # --------------------------------------------------------
    # Add bias
    # --------------------------------------------------------

    acc = acc + b_int


    # --------------------------------------------------------
    # Hardware rounding before shift
    #
    # Hardware:
    #
    #       (acc + 64) >>> 7
    #
    # --------------------------------------------------------

    acc = acc + 64.0


    # --------------------------------------------------------
    # Arithmetic right shift equivalent
    #
    # IMPORTANT:
    #
    # We use floor(acc / 128), which corresponds to
    # arithmetic right shift for signed integers.
    # --------------------------------------------------------

    scaled = ste_floor(
        acc / SCALE
    )


    # --------------------------------------------------------
    # INT8 saturation
    # --------------------------------------------------------

    scaled = torch.clamp(
        scaled,
        QMIN,
        QMAX
    )


    # --------------------------------------------------------
    # Convert back to Q1.7 representation
    #
    # This represents the actual INT8 value.
    # --------------------------------------------------------

    output = scaled / SCALE


    # --------------------------------------------------------
    # ReLU
    # --------------------------------------------------------

    if relu:

        output = torch.relu(
            output
        )


    return output


# ============================================================
# 13. QAT MODEL
# ============================================================

class HardwareQATModel(nn.Module):

    def __init__(self):

        super(
            HardwareQATModel,
            self
        ).__init__()


        self.layer1 = nn.Linear(
            784,
            64
        )

        self.layer2 = nn.Linear(
            64,
            32
        )

        self.layer3 = nn.Linear(
            32,
            16
        )

        self.layer4 = nn.Linear(
            16,
            10
        )


    def forward(self, x):

        # ----------------------------------------------------
        # Flatten
        # ----------------------------------------------------

        x = x.view(
            -1,
            784
        )


        # ----------------------------------------------------
        # Hardware input:
        #
        # pixel [0,1]
        #       ↓
        # floor(pixel*128)
        #       ↓
        # INT8
        # ----------------------------------------------------

        x = fake_quant_input(
            x
        )


        # ----------------------------------------------------
        # Layer 1
        # 784 -> 64
        # ----------------------------------------------------

        x = qat_hardware_linear(
            x,
            self.layer1.weight,
            self.layer1.bias,
            relu=True
        )


        # ----------------------------------------------------
        # Layer 2
        # 64 -> 32
        # ----------------------------------------------------

        x = qat_hardware_linear(
            x,
            self.layer2.weight,
            self.layer2.bias,
            relu=True
        )


        # ----------------------------------------------------
        # Layer 3
        # 32 -> 16
        # ----------------------------------------------------

        x = qat_hardware_linear(
            x,
            self.layer3.weight,
            self.layer3.bias,
            relu=True
        )


        # ----------------------------------------------------
        # Layer 4
        # 16 -> 10
        #
        # NO ReLU
        # ----------------------------------------------------

        x = qat_hardware_linear(
            x,
            self.layer4.weight,
            self.layer4.bias,
            relu=False
        )


        return x


