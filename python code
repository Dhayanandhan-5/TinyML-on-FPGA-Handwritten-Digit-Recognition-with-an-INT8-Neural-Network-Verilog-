W3_q = numpy_quantize_weight(W3)
B3_q = numpy_quantize_bias(B3)

W4_q = numpy_quantize_weight(W4)
B4_q = numpy_quantize_bias(B4)


# ============================================================
# 20. EXACT HARDWARE LAYER
#
# This matches your MATLAB:
#
# p = int16(w).*int16(in)
# si = int32(sum(p))
# s = si + bias
# k = bitsra(s+64,7)
#
# then saturation + ReLU
# ============================================================

def exact_hardware_layer(
    x,
    W,
    B,
    relu=True
):

    # --------------------------------------------------------
    # Convert to INT32 before multiplication
    # --------------------------------------------------------

    x32 = x.astype(
        np.int32
    )

    W32 = W.astype(
        np.int32
    )

    B32 = B.astype(
        np.int32
    )


    # --------------------------------------------------------
    # MAC
    #
    # W shape:
    #   output_neurons x input_neurons
    #
    # x shape:
    #   input_neurons
    # --------------------------------------------------------

    acc = W32 @ x32


    # --------------------------------------------------------
    # Bias
    # --------------------------------------------------------

    acc = acc + B32


    # --------------------------------------------------------
    # Hardware:
    #
    #       +64
    #       >>>7
    #
    # For signed integer arithmetic this is floor division
    # by 128.
    # --------------------------------------------------------

    acc = np.floor_divide(
        acc + 64,
        128
    )


    # --------------------------------------------------------
    # INT8 saturation
    # --------------------------------------------------------

    acc = np.clip(
        acc,
        -128,
        127
    )


    # --------------------------------------------------------
    # ReLU
    # --------------------------------------------------------

    if relu:

        acc[acc < 0] = 0


    return acc.astype(
        np.int8
    )


# ============================================================
# 21. EXACT HARDWARE INFERENCE
# ============================================================

def exact_hardware_inference(
    image
):

    # --------------------------------------------------------
    # Hardware input conversion:
    #
    # floor(pixel * 128)
    # --------------------------------------------------------

    x = np.floor(
        image * 128
    )


    x = np.clip(
        x,
        -128,
        127
    )


    x = x.astype(
        np.int8
    )


    # --------------------------------------------------------
    # 28x28 -> 784
    # --------------------------------------------------------

    x = x.reshape(
        -1
    )


    # --------------------------------------------------------
    # Layer 1
    # --------------------------------------------------------

    x = exact_hardware_layer(
        x,
        W1_q,
        B1_q,
        relu=True
    )


    # --------------------------------------------------------
    # Layer 2
    # --------------------------------------------------------

    x = exact_hardware_layer(
        x,
        W2_q,
        B2_q,
        relu=True
    )


    # --------------------------------------------------------
    # Layer 3
    # --------------------------------------------------------

    x = exact_hardware_layer(
        x,
        W3_q,
        B3_q,
        relu=True
    )


    # --------------------------------------------------------
    # Layer 4
    # --------------------------------------------------------

    x = exact_hardware_layer(
        x,
        W4_q,
        B4_q,
        relu=False
    )


    # --------------------------------------------------------
    # Argmax
    # --------------------------------------------------------

    prediction = int(
        np.argmax(x)
    )


    return prediction, x


