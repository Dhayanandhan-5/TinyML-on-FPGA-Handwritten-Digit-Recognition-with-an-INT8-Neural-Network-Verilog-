def quantization_report(
    name,
    W
):

    q = np.round(
        W * 128
    )


    clipped = np.sum(
        (q < -128) |
        (q > 127)
    )


    total = q.size


    print(
        f"{name}: "
        f"{clipped}/{total} "
        f"("
        f"{100.0*clipped/total:.4f}%"
        f") clipped"
    )


    print(
        f"    Float range: "
        f"{W.min():.6f} "
        f"to "
        f"{W.max():.6f}"
    )


